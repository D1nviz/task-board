# Copy to .env and adjust. HOST, PORT and NODE_ENV have defaults, the rest is required.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Matches the docker run command in README.md
DATABASE_URL=postgresql://taskboard:taskboard@localhost:5433/task_board

# Any long random string, for example: openssl rand -hex 32
JWT_SECRET=change-me

# Comma-separated list of allowed origins, omit to allow none
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173
